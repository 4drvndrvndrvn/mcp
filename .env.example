# Your NanoGPT API key (https://nano-gpt.com/api). Needed for the web chat and web_search;
# without it /mcp still offers the Vast.ai and SSH tools to Claude.
NANOGPT_API_KEY=

# Optional settings
# NANOGPT_BASE_URL=https://nano-gpt.com/api/v1
# DEFAULT_MODEL=openai/gpt-5.4-mini
# HOST=127.0.0.1
# PORT=3000
# MAX_TOOL_ROUNDS=20
# MCP_CONFIG=./mcp-servers.json

# Set this to require a token for the web UI, /api and /mcp.
# Strongly recommended if HOST is anything other than 127.0.0.1.
# ACCESS_TOKEN=
# Clients that can't send headers (claude.ai connectors) can use /mcp/<ACCESS_TOKEN>.

# Behind a reverse proxy: the domain it forwards (comma-separated)
# ALLOWED_HOSTS=chat.example.com
# MCP servers whose tools /mcp offers to Claude (default: all)
# EXPOSE_MCP_SERVERS=vast,ssh,web

# ---- Vast.ai MCP server (servers/vast.js) ----
# API key from https://cloud.vast.ai/manage-keys/ (searching offers works without it)
VAST_API_KEY=
# Refuse to rent machines that cost more than this per hour
# VAST_MAX_PRICE_PER_HOUR=1.00
# SSH key used to reach your instances; created automatically if missing
# VAST_SSH_KEY_PATH=.data/vast_ed25519
# Desktop screenshots wider than this are scaled down
# VAST_SCREENSHOT_WIDTH=1280

# ---- SSH MCP server (servers/ssh.js) ----
# Private key (default: ~/.ssh/id_ed25519, id_ecdsa or id_rsa). An ssh-agent also works.
# SSH_KEY_PATH=~/.ssh/id_ed25519
# SSH_KEY_PASSPHRASE=
# JSON file of named hosts: {"gpu": {"host": "1.2.3.4", "port": 22, "username": "root"}}
# SSH_HOSTS_FILE=./ssh-hosts.json
# Only allow these hostnames (comma-separated, * wildcards)
# SSH_ALLOWED_HOSTS=*.vast.ai,192.168.1.*
# SSH_DEFAULT_USER=root
# Refuse hosts that are not already in ~/.ssh/known_hosts
# SSH_STRICT_HOST_KEY_CHECKING=yes
